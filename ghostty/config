# --- THEME & APPEARANCE SETTINGS ---
theme = GitHub-Dark-High-Contrast
background-opacity = 0.85
# background-blur-radius = 20
# config-file = themes/rosepine

# --- SHADER SETTINGS ---
# custom-shader = shaders/bloom.glsl

# --- FONT SETTINGS ---
font-family = JetBrainsMono NFM
font-style = SemiBold
font-style-bold = ExtraBold
font-style-italic = SemiBold Italic
font-style-bold-italic = ExtraBold Italic
font-size = 14
bold-is-bright = true

# --- CURSOR SETTINGS ---
cursor-style = block
cursor-style-blink = true
cursor-invert-fg-bg = true

# --- WINDOW & UI SETTINGS ---
window-width = 130
window-height = 33
window-theme = ghostty
mouse-hide-while-typing = true
gtk-titlebar = false
confirm-close-surface = false
window-decoration = true
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true

# --- UPDATE SETTINGS ---
auto-update = check
auto-update-channel = stable

# --- EXTRA FEATURES ---
shell-integration-features = no-cursor 
# copy-on-select = clipboard
confirm-close-surface = true

# --- CUSTOM KEYBINDINGS ---
## Simple Keybinds
keybind = super+r=reload_config 
keybind = super+i=inspector:toggle

## Tab Management Keybindings
keybind = ctrl+w=close_surface
keybind = ctrl+t=new_tab
keybind = super+u=toggle_tab_overview

## Tab Navigation
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

## Tmux-like Keybinds
# (ctrl+b for tmux -> cmd+b for ghostty)
keybind = super+b>x=close_surface

## Splitting
keybind = super+b>\=new_split:right
keybind = super+b>-=new_split:down
keybind = super+b>e=equalize_splits
